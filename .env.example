# API generation is for real people using the cabinet, not developer tests.
OPENAI_API_KEY=
# Recorded speech uses the same server-side OpenAI key.
HTN_STT=openai
HTN_STT_MODEL=gpt-4o-mini-transcribe
# Explicit offline alternative: HTN_STT=local (Whisper tiny.en).
# Legacy HTN_STT_PROVIDER remains supported when HTN_STT is unset.
# Assistant development/base games/testing use the Codex Astra subscription.
# Developer CLI model requests are blocked regardless of this key.

# Local researched design guidance, enabled by default. Set 0 for comparison runs.
HTN_DESIGN_CONTEXT=1

# Astra generation and full-file repair. CLI remix keeps its separate setting.
# The code default is low (88 s against 279 s at medium for the same prompt on
# 2026-09-20); the cabinet runs medium by decision on 2026-09-20 for quality.
HTN_BUILD_EFFORT=medium
HTN_REPAIR_EFFORT=medium
# Tested local implementation references; disable for comparison runs.
HTN_REFERENCE_CONTEXT=1

# Verified local game foundations and source-checked sprite assets.
HTN_CATALOG=1

# Optional hybrid experiment: Jev selects a foundation/settings; Astra writes code.
# Copy this file to .env in this worktree and fill both provider keys to enable it.
# With HTN_JEV absent or 0, the original pipeline remains available.
HTN_JEV=1
TYPESAFE_API_KEY=
HTN_JEV_MODEL=jev-1.13.0

# Public website and private cabinet sync (apps/web needs only the NEXT_PUBLIC values).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
