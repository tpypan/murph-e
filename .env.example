# API generation is for real people using the cabinet, not developer tests.
OPENAI_API_KEY=
# Assistant development/base games/testing use the Codex Astra subscription.
# Developer CLI model requests are blocked regardless of this key.

# Local researched design guidance, enabled by default. Set 0 for comparison runs.
HTN_DESIGN_CONTEXT=1

# Astra generation and full-file repair. CLI remix keeps its separate setting.
HTN_BUILD_EFFORT=medium
HTN_REPAIR_EFFORT=medium
# Tested local implementation references; disable for comparison runs.
HTN_REFERENCE_CONTEXT=1

# Verified local game foundations and source-checked sprite assets.
HTN_CATALOG=1
