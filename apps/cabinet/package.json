{
  "name": "@htn/cabinet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-runtime": "mkdir -p public/runtime && cp ../../packages/runtime/runtime.js ../../packages/runtime/index.html ../../packages/runtime/build-preview.html public/runtime/",
    "predev": "pnpm --filter @htn/runtime build && pnpm sync-runtime",
    "dev": "next dev",
    "prebuild": "pnpm --filter @htn/runtime build && pnpm sync-runtime",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@htn/harness": "workspace:*",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@htn/probe": "workspace:*",
    "openai": "^6.0.0",
    "playwright": "^1.55.0",
    "@htn/badge": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.2"
  }
}
