{
  "name": "htn-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter @htn/cabinet dev",
    "harness": "pnpm --filter @htn/harness exec tsx src/cli.ts",
    "probe": "pnpm --filter @htn/probe exec tsx src/cli.ts",
    "playtest": "pnpm --filter @htn/probe exec tsx src/playtest-cli.ts",
    "serve": "node scripts/serve.mjs",
    "runtime:build": "pnpm --filter @htn/runtime build && pnpm --filter @htn/cabinet sync-runtime",
    "runtime:watch": "pnpm --filter @htn/runtime watch",
    "sounds:check": "pnpm --filter @htn/harness exec node --import tsx ../../scripts/audit-game-audio.ts --index",
    "exercise": "pnpm --filter @htn/probe exec node scripts/exercise-runtime.mjs",
    "screenshots": "pnpm --filter @htn/probe exec node scripts/screenshot-runtime.mjs",
    "screenshots:cabinet": "pnpm --filter @htn/probe exec node scripts/screenshot-cabinet.mjs",
    "stt:setup": "python3 -m venv .venv-stt && .venv-stt/bin/python -m pip install -r scripts/whisper-requirements.txt && .venv-stt/bin/python scripts/setup-whisper.py",
    "stt:test": "pnpm --filter @htn/probe exec node scripts/stt-test.mjs",
    "gallery": "node scripts/gallery.mjs && node scripts/serve.mjs & sleep 1; open http://localhost:5173/library/gallery.html",
    "badge": "pnpm --filter @htn/badge exec tsx src/cli.ts",
    "test:badge": "pnpm --filter @htn/badge exec node --import tsx --test \"test/*.test.ts\"",
    "test:scores": "pnpm --filter @htn/harness exec node --import tsx --test \"test/*.test.ts\"",
    "test:probe": "pnpm --filter @htn/probe exec node --import tsx --test scripts/input-probe.test.mjs scripts/palette-probe.test.mjs scripts/playtest.test.mjs",
    "test": "pnpm test:badge && pnpm test:scores"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "typescript": "^5.9.2"
  }
}
